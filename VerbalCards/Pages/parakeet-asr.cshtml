@page "/verbal-flashcards"
@model VerbalCards.Pages.parakeet_asr

@{
ViewData["Title"] = "Verbal Flashcards";
Layout = "Shared/_Layout";
}

<link rel="stylesheet" href="~/css/flashcards.css" />

<div class="flashcard-container">
    <!-- Header with stats and filters -->
    <div class="header">
        <div class="title-section">
            <div class="title-container">
                <img src="logo.png" width="25px" height="25px" alt="logo" />
                <h2>Verbal Flashcards</h2>
            </div>
            <div class="filters">
                <select id="categoryFilter" class="filter-select">
                    <option value="">All Categories</option>
                </select>
                <select id="difficultyFilter" class="filter-select">
                    <option value="">All Difficulties</option>
                    <option value="Beginner">Beginner</option>
                    <option value="Intermediate">Intermediate</option>
                    <option value="Advanced">Advanced</option>
                </select>
                <button id="applyFiltersBtn" class="filter-btn">Apply Filters</button>
                <select id="noiseSensitivity" class="filter-select">
                    <option value="0.03">Low Noise (Indoor)</option>
                    <option value="0.05" selected>Medium Noise (Outdoor)</option>
                    <option value="0.08">High Noise (Street)</option>
                    <option value="0.11">Very High Noise (Windy)</option>
                </select>
            </div>
        </div>
        <div class="stats">
            <div class="stat-item">
                <span class="stat-label">Progress:</span>
                <span id="cardCounter">0/0</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Score:</span>
                <span id="scoreDisplay">0</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Streak:</span>
                <span id="streakDisplay">0</span>
            </div>
        </div>
    </div>

    <!-- Main flashcard -->
    <div class="flashcard" id="flashcard">
        <div class="card-content">
            <!-- Loading state -->
            <div id="loadingState" class="loading-state">
                <div class="spinner"></div>
                <p>Loading flashcards...</p>
            </div>

            <!-- Flashcard content (hidden while loading) -->
            <div id="flashcardContent" style="display: none;">
                <!-- Prompt section -->
                <div class="prompt-section">
                    <span class="badge" id="difficultyBadge">Beginner</span>
                    <span class="badge" id="categoryBadge">Greetings</span>
                    <h3 class="prompt-label">Say this:</h3>
                    <div id="currentPrompt" class="prompt-text">Loading...</div>
                    <div id="phoneticHint" class="phonetic-hint"></div>
                </div>

                <!-- Hint section (collapsible) -->
                <div class="hint-section">
                    <button type="button" id="showHintBtn" class="hint-toggle">
                        <span class="hint-icon">💡</span>
                        <span class="hint-text">Show Hint</span>
                    </button>
                    <div id="hintContent" class="hint-content" style="display: none;">
                        <div class="hint-box">
                            <p id="currentHint"></p>
                            <p id="exampleSentence" class="example-sentence"></p>
                        </div>
                    </div>
                </div>

                <!-- Recording section -->
                <div class="recording-section">
                    <button type="button" id="recordButton" class="record-btn">
                        <span class="record-icon">🎤</span>
                        <span class="record-text">Start Recording</span>
                    </button>

                    <div id="status" class="status-message">Ready to record</div>

                    <!-- Recording visualization -->
                    <div id="recordingVisualization" class="recording-visualization" style="display: none;">
                        <div class="sound-wave">
                            <span></span><span></span><span></span><span></span><span></span>
                        </div>
                    </div>
                </div>

                <!-- Result section -->
                <div id="resultSection" class="result-section" style="display: none;">
                    <h4>Your attempt:</h4>
                    <div id="userSpeech" class="user-speech"></div>

                    <div class="feedback">
                        <div class="accuracy-meter">
                            <div class="accuracy-label">Accuracy:</div>
                            <div class="progress-bar">
                                <div id="accuracyProgress" class="progress-fill" style="width: 0%"></div>
                            </div>
                            <span id="accuracyPercentage" class="accuracy-percentage">0%</span>
                        </div>

                        <div id="feedbackMessage" class="feedback-message"></div>
                        <div id="detailedAnalysis" class="detailed-analysis"></div>
                    </div>

                    <!-- Word-by-word breakdown -->
                    <div id="wordBreakdown" class="word-breakdown" style="display: none;">
                        <h5>Word breakdown:</h5>
                        <div id="wordList" class="word-list"></div>
                    </div>
                </div>

                <!-- Navigation and actions -->
                <div class="action-buttons">
                    <div class="navigation-buttons">
                        <button type="button" id="prevButton" class="nav-btn" disabled>← Previous</button>
                        <button type="button" id="nextButton" class="nav-btn" disabled>Next →</button>
                    </div>
                    <div class="utility-buttons">
                        <button type="button" id="shuffleBtn" class="utility-btn" title="Shuffle cards">🔄</button>
                        <button type="button" id="repeatBtn" class="utility-btn" title="Repeat this card">🔁</button>
                        <button type="button" id="infoBtn" class="utility-btn" title="Card info">ℹ️</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress modal (hidden by default) -->
    <div id="infoModal" class="modal" style="display: none;">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h3>Card Information</h3>
            <div id="modalContent"></div>
        </div>
    </div>
</div>

<script>
    // State management
    let mediaRecorder;
    let audioChunks = [];
    let isRecording = false;
    let flashcards = [];
    let filteredFlashcards = [];
    let currentCardIndex = 0;
    let totalScore = 0;
    let currentStreak = 0;
    let categories = [];

    const SILENCE_THRESHOLD_MS = 1500;
    let vadInstance;
    let silenceStart = null;
    let speechDetected = false;
    let statusUpdateTimeout = null;
    let lastStatusText = "";
    let speechStartTime = null;
    let cooldownTimeout = null;
    let isCooldown = false;

    // DOM elements
    const recordButton = document.getElementById("recordButton");
    const statusDiv = document.getElementById("status");
    const currentPrompt = document.getElementById("currentPrompt");
    const phoneticHint = document.getElementById("phoneticHint");
    const cardCounter = document.getElementById("cardCounter");
    const scoreDisplay = document.getElementById("scoreDisplay");
    const streakDisplay = document.getElementById("streakDisplay");
    const prevButton = document.getElementById("prevButton");
    const nextButton = document.getElementById("nextButton");
    const showHintBtn = document.getElementById("showHintBtn");
    const hintContent = document.getElementById("hintContent");
    const currentHint = document.getElementById("currentHint");
    const exampleSentence = document.getElementById("exampleSentence");
    const resultSection = document.getElementById("resultSection");
    const userSpeech = document.getElementById("userSpeech");
    const accuracyProgress = document.getElementById("accuracyProgress");
    const accuracyPercentage = document.getElementById("accuracyPercentage");
    const feedbackMessage = document.getElementById("feedbackMessage");
    const detailedAnalysis = document.getElementById("detailedAnalysis");
    const wordBreakdown = document.getElementById("wordBreakdown");
    const wordList = document.getElementById("wordList");
    const difficultyBadge = document.getElementById("difficultyBadge");
    const categoryBadge = document.getElementById("categoryBadge");
    const recordingVisualization = document.getElementById("recordingVisualization");
    const loadingState = document.getElementById("loadingState");
    const flashcardContent = document.getElementById("flashcardContent");
    const categoryFilter = document.getElementById("categoryFilter");
    const difficultyFilter = document.getElementById("difficultyFilter");
    const applyFiltersBtn = document.getElementById("applyFiltersBtn");
    const shuffleBtn = document.getElementById("shuffleBtn");
    const repeatBtn = document.getElementById("repeatBtn");
    const infoBtn = document.getElementById("infoBtn");
    const infoModal = document.getElementById("infoModal");
    const closeModal = document.querySelector(".close-modal");
    const noiseSensitivity = document.getElementById("noiseSensitivity");

    // Initialize the app
    async function initialize() {
        await loadFlashcards();
        setupEventListeners();
    }

    // Load flashcards
    async function loadFlashcards() {
        try {
            loadingState.style.display = "flex";
            flashcardContent.style.display = "none";

            const category = categoryFilter.value;
            const difficulty = difficultyFilter.value;

            let url = "/flashcards";
            const params = new URLSearchParams();
            if (category) params.append("category", category);
            if (difficulty) params.append("difficulty", difficulty);
            if (params.toString()) url += "?" + params.toString();

            const response = await fetch(url);
            if (response.ok) {
                flashcards = await response.json();
                filteredFlashcards = [...flashcards];

                // Extract unique categories for filter
                updateCategoryFilter();

                if (filteredFlashcards.length === 0) {
                    showNoCardsMessage();
                } else {
                    currentCardIndex = 0;
                    updateCard();
                    flashcardContent.style.display = "block";
                }
            }
        } catch (error) {
            console.error("Error loading flashcards:", error);
            statusDiv.textContent = "Error loading flashcards";
        } finally {
            loadingState.style.display = "none";
        }
    }

    // Update category filter dropdown
    function updateCategoryFilter() {
        const categories = [...new Set(flashcards.map(c => c.category))];
        categoryFilter.innerHTML = '<option value="">All Categories</option>';
        categories.forEach(category => {
            if (category) {
                const option = document.createElement("option");
                option.value = category;
                option.textContent = category;
                categoryFilter.appendChild(option);
            }
        });
    }

    // Show message when no cards match filters
    function showNoCardsMessage() {
        flashcardContent.style.display = "none";
        const existingMsg = document.querySelector(".no-cards-message");
        if (existingMsg) existingMsg.remove();

        const noCardsMsg = document.createElement("div");
        noCardsMsg.className = "no-cards-message";
        noCardsMsg.innerHTML = `
            <p>😕 No flashcards match your filters</p>
            <button onclick="clearFilters()" class="filter-btn">Clear Filters</button>
        `;
        document.querySelector(".flashcard").appendChild(noCardsMsg);
    }

    // Clear all filters
    window.clearFilters = function() {
        categoryFilter.value = "";
        difficultyFilter.value = "";
        loadFlashcards();
    };

    // Update current card display
    function updateCard() {
        if (filteredFlashcards.length === 0) return;

        const card = filteredFlashcards[currentCardIndex];
        currentPrompt.textContent = card.prompt;
        phoneticHint.textContent = card.phoneticHint || "";
        currentHint.textContent = card.hint || "No hint available";
        exampleSentence.textContent = card.example || "";
        difficultyBadge.textContent = card.difficulty || "Beginner";
        categoryBadge.textContent = card.category || "General";

        // Update badges based on difficulty
        difficultyBadge.className = `badge difficulty-${(card.difficulty || "beginner").toLowerCase()}`;

        cardCounter.textContent = `${currentCardIndex + 1}/${filteredFlashcards.length}`;

        // Hide result section when changing cards
        resultSection.style.display = "none";
        hintContent.style.display = "none";
        showHintBtn.querySelector('.hint-text').textContent = "Show Hint";

        // Update navigation buttons
        prevButton.disabled = currentCardIndex === 0;
        nextButton.disabled = currentCardIndex === filteredFlashcards.length - 1;

        // Reset recording state
        if (isRecording) {
            stopRecording();
        }
        recordButton.disabled = false;
        recordButton.querySelector('.record-text').textContent = "Start Recording";
        statusDiv.textContent = "Ready to record";
        statusDiv.className = "status-message";
    }

    // Update stopRecording to clean up properly
    function stopRecording() {
        if (mediaRecorder && isRecording) {
            mediaRecorder.stop();
            isRecording = false;

            // Stop all tracks
            if (mediaRecorder.stream) {
                mediaRecorder.stream.getTracks().forEach(track => track.stop());
            }

            // Clean up audio context
            if (window.audioContext) {
                window.audioContext.close().catch(console.warn);
                window.audioContext = null;
            }

            // Clear any pending timer
            if (window.silenceTimer) {
                clearTimeout(window.silenceTimer);
                window.silenceTimer = null;
            }

            recordButton.querySelector('.record-text').textContent = "Start Recording";
            recordingVisualization.style.display = "none";
            statusDiv.textContent = "✅ Ready to record";
            statusDiv.className = "status-message";

            // Reset flags
            speechDetected = false;
            silenceStart = null;
        }
    }

    function ensureAudioContextRunning() {
        if (vadInstance && vadInstance.audioContext && vadInstance.audioContext.state === 'suspended') {
            vadInstance.audioContext.resume().catch(console.warn);
        }
    }


    // Set up event listeners
    function setupEventListeners() {
        // Recording button
        recordButton.addEventListener("click", toggleRecording);

        // Navigation
        prevButton.addEventListener("click", () => {
            if (currentCardIndex > 0) {
                currentCardIndex--;
                updateCard();
            }
        });

        nextButton.addEventListener("click", () => {
            if (currentCardIndex < filteredFlashcards.length - 1) {
                currentCardIndex++;
                updateCard();
                toggleRecording();
            }
        });

        // Hint toggle
        showHintBtn.addEventListener("click", toggleHint);

        // Filter button
        applyFiltersBtn.addEventListener("click", loadFlashcards);

        // Shuffle button
        shuffleBtn.addEventListener("click", shuffleCards);

        // Repeat button
        repeatBtn.addEventListener("click", () => {
            updateCard(); // Just refreshes the current card
            toggleRecording();
        });

        // Info button
        infoBtn.addEventListener("click", showCardInfo);

        if (noiseSensitivity) {
            noiseSensitivity.addEventListener("change", () => {
                const newThreshold = parseFloat(noiseSensitivity.value);
                console.log(`🎚️ Noise sensitivity changed to: ${newThreshold}`);

                // Provide immediate feedback to user
                statusDiv.textContent = `Sensitivity set to ${noiseSensitivity.options[noiseSensitivity.selectedIndex].text}`;
                setTimeout(() => {
                    if (!isRecording) {
                        statusDiv.textContent = "Ready to record";
                    }
                }, 2000);
            });
        }

        // Close modal
        if (closeModal) {
            closeModal.addEventListener("click", () => {
                infoModal.style.display = "none";
            });
        }

        // Click outside modal to close
        window.addEventListener("click", (event) => {
            if (event.target === infoModal) {
                infoModal.style.display = "none";
            }
        });
    }

    // Toggle recording
    async function toggleRecording() {
        if (!isRecording) {
            await startRecording();
        } else {
            stopRecording();
        }
    }

    async function startRecording() {
        // Prevent starting recording if already recording or in cooldown
        if (isCooldown) {
            console.log("Cannot start recording - already in cooldown");
            return;
        }

        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            console.log("🎙️ Starting cooldown before recording...");

            // Set cooldown state
            isCooldown = true;
            recordButton.disabled = true;

            // Show cooldown countdown
            let cooldownSeconds = 5;
            statusDiv.textContent = `⏳ Get ready... Starting in ${cooldownSeconds}s`;
            statusDiv.className = "status-message cooldown";

            // Create countdown interval
            const countdownInterval = setInterval(() => {
                if (!isCooldown) {
                    clearInterval(countdownInterval);
                    return;
                }

                cooldownSeconds--;
                if (cooldownSeconds > 0) {
                    statusDiv.textContent = `⏳ Get ready... Starting in ${cooldownSeconds}s`;
                } else {
                    clearInterval(countdownInterval);
                }
            }, 1000);

            // Wait for cooldown
            cooldownTimeout = setTimeout(async () => {
                try {
                    console.log("🎙️ Cooldown finished, starting recording...");
                    
                    console.log("✅ Microphone access granted");

                    // Setup media recorder first
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];

                    mediaRecorder.addEventListener("dataavailable", event => {
                        console.log("📀 Data available, size:", event.data.size);
                        audioChunks.push(event.data);
                    });

                    mediaRecorder.addEventListener("stop", handleRecordingStop);

                    // Set isRecording to true BEFORE starting detection
                    isRecording = true;
                    isCooldown = false;
                    recordButton.disabled = false;

                    // Setup audio level detection
                    const detectionSetupSuccess = setupVAD(stream);

                    if (!detectionSetupSuccess) {
                        console.warn("⚠️ Audio detection failed, recording without auto-stop");
                        statusDiv.textContent = "Recording... (auto-stop disabled)";
                    }

                    mediaRecorder.start();
                    console.log("📹 MediaRecorder started");

                    recordButton.querySelector('.record-text').textContent = "Stop Recording";
                    statusDiv.textContent = "🔴 Recording... Speak now";
                    statusDiv.className = "status-message recording";
                    recordingVisualization.style.display = "block";

                    // Hide previous results
                    resultSection.style.display = "none";

                    // Reset detection flags
                    speechDetected = false;
                    silenceStart = null;

                } catch (error) {
                    console.error("❌ Recording error:", error);
                    statusDiv.textContent = "❌ Microphone access denied";
                    statusDiv.className = "status-message error";
                    alert("Please allow microphone access to use flashcards");
                    isRecording = false;
                    isCooldown = false;
                    recordButton.disabled = false;
                    recordButton.querySelector('.record-text').textContent = "Start Recording";
                }
            }, 5000);

        } catch (error) {
            console.error("❌ Cooldown error:", error);
            statusDiv.textContent = "❌ Error starting recording";
            statusDiv.className = "status-message error";
            isCooldown = false;
            recordButton.disabled = false;
        }
    }

    // Handle recording stop and send to FastAPI directly
    async function handleRecordingStop() {
        statusDiv.textContent = "Processing...";
        statusDiv.className = "status-message processing";
        recordingVisualization.style.display = "none";

        // Create audio blob from recorded chunks
        const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });

        // Create form data for FastAPI
        const formData = new FormData();
        formData.append("file", audioBlob, "recording.wav");

        try {
            // Call FastAPI directly (like in your Upload page)
            const fastApiResponse = await fetch('http://localhost:8000/transcribe', {
                method: 'POST',
                body: formData,
                mode: 'cors'
            });

            if (!fastApiResponse.ok) {
                throw new Error(`Transcription failed: ${fastApiResponse.status}`);
            }

            const data = await fastApiResponse.json();
            const transcription = data.transcription;

            // Check pronunciation locally
            const result = calculateAccuracy(transcription,
                filteredFlashcards[currentCardIndex].expectedText ||
                filteredFlashcards[currentCardIndex].prompt);
            displayResults(transcription, result);

        } catch (error) {
            //showError(error.message);
        } finally {
            statusDiv.textContent = "Ready to record";
            statusDiv.className = "status-message";
        }
    }

    // Calculate accuracy between user speech and expected text
    function calculateAccuracy(userSpeech, expectedText) {
        userSpeech = userSpeech?.toLowerCase().trim() || "";
        expectedText = expectedText?.toLowerCase().trim() || "";

        console.log("User speech:", userSpeech);
        console.log("Expected:", expectedText);

        // Preserve Danish characters while removing punctuation
        userSpeech = userSpeech.replace(/[^\w\sæøåÆØÅ']/g, ' ');
        expectedText = expectedText.replace(/[^\w\sæøåÆØÅ']/g, ' ');

        // Normalize multiple spaces
        userSpeech = userSpeech.replace(/\s+/g, ' ').trim();
        expectedText = expectedText.replace(/\s+/g, ' ').trim();

        const userWords = userSpeech.split(/\s+/).filter(w => w.length > 0);
        const expectedWords = expectedText.split(/\s+/).filter(w => w.length > 0);

        console.log("User words:", userWords);
        console.log("Expected words:", expectedWords);

        const wordMatches = [];
        let correctWords = 0;
        let correctPositions = 0;
        const matchedIndices = new Set();

        // First pass: find exact position matches (correct word in correct position)
        for (let i = 0; i < Math.min(userWords.length, expectedWords.length); i++) {
            const userWord = userWords[i];
            const expectedWord = expectedWords[i];

            // Check if word matches (with Danish normalization)
            if (userWord === expectedWord ||
                normalizeDanishWord(userWord) === normalizeDanishWord(expectedWord)) {

                correctWords++;
                correctPositions++;
                matchedIndices.add(i);
                wordMatches.push({
                    word: expectedWord,
                    isCorrect: true,
                    isInPosition: true,
                    userWord: userWord,
                    position: i,
                    suggestedWord: null
                });
            }
        }

        // Second pass: find remaining correct words (correct word, wrong position)
        for (let i = 0; i < expectedWords.length; i++) {
            // Skip if we already matched this expected word in the right position
            if (wordMatches.some(m => m.position === i && m.isInPosition)) continue;

            const expectedWord = expectedWords[i];
            let found = false;

            for (let j = 0; j < userWords.length; j++) {
                // Skip if this user word is already matched
                if (matchedIndices.has(j)) continue;

                const userWord = userWords[j];

                // Check if words match (with Danish support)
                if (userWord === expectedWord ||
                    normalizeDanishWord(userWord) === normalizeDanishWord(expectedWord)) {

                    matchedIndices.add(j);
                    correctWords++;
                    wordMatches.push({
                        word: expectedWord,
                        isCorrect: true,
                        isInPosition: false,
                        userWord: userWord,
                        position: i,
                        expectedPosition: i,
                        actualPosition: j,
                        suggestedWord: userWord
                    });
                    found = true;
                    break;
                }
            }

            if (!found) {
                wordMatches.push({
                    word: expectedWord,
                    isCorrect: false,
                    isInPosition: false,
                    position: i,
                    suggestedWord: "?"
                });
            }
        }

        // Sort word matches by original position for display
        wordMatches.sort((a, b) => a.position - b.position);

        // Calculate accuracy with position weighting
        const wordAccuracy = expectedWords.length > 0
            ? Math.round((correctWords / expectedWords.length) * 100)
            : 0;

        // Position accuracy: how many words are in the correct position
        const positionAccuracy = expectedWords.length > 0
            ? Math.round((correctPositions / expectedWords.length) * 100)
            : 0;

        // Combined score: 70% word accuracy + 30% position accuracy
        const finalAccuracy = Math.round((wordAccuracy * 0.7) + (positionAccuracy * 0.3));

        console.log(`Word accuracy: ${wordAccuracy}%, Position accuracy: ${positionAccuracy}%, Final: ${finalAccuracy}%`);
        console.log(`Correct positions: ${correctPositions}/${expectedWords.length}`);

        // Generate appropriate feedback message
        const feedback = getFeedbackMessage(finalAccuracy, correctPositions, expectedWords.length);
        const detailedAnalysis = generateDetailedAnalysis(finalAccuracy, correctWords, correctPositions, expectedWords.length, wordMatches);

        return {
            accuracy: finalAccuracy,
            wordAccuracy: wordAccuracy,
            positionAccuracy: positionAccuracy,
            feedback: feedback,
            wordMatches: wordMatches,
            detailedAnalysis: detailedAnalysis
        };
    }

    // Add this helper function for Danish character normalization
    function normalizeDanishWord(word) {
        if (!word) return "";

        word = word.toLowerCase();

        // Handle common Danish spelling variations
        const variations = {
            'aa': 'å',
            'ae': 'æ',
            'oe': 'ø',
            'hv': 'v',     // "hv" in "hvornår" often sounds like "v"
        };

        // Replace common variations
        for (let [pattern, replacement] of Object.entries(variations)) {
            word = word.replace(new RegExp(pattern, 'g'), replacement);
        }

        // Handle soft D at end of words (common in Danish)
        if (word.endsWith('d')) {
            word = word.slice(0, -1);
        }

        return word;
    }

    // Update getFeedbackMessage to include position information
    function getFeedbackMessage(accuracy, correctPositions, totalWords) {
        if (accuracy >= 95) return "Excellent! Totally perfect! 🌟";
        if (accuracy >= 85) return "Great! Almost perfect! ✨";
        if (accuracy >= 70) {
            if (correctPositions === totalWords) {
                return "Nice job! The words are in the right order! 👍";
            } else {
                return "Nice job! Try to focus on word order 🎯";
            }
        }
        if (accuracy >= 50) {
            if (correctPositions < totalWords / 2) {
                return "Not bad! Remember, word order is very important in danish 📝";
            } else {
                return "Not bad! Keep practicing! 💪";
            }
        }
        if (accuracy >= 30) return "Keep going! Try again 📚";
        if (accuracy >= 10) return "Start slowly, say every word clearly 🗣️";
        return "Try again, take your time with each word 💪";
    }

    // Update generateDetailedAnalysis to include position feedback
    function generateDetailedAnalysis(finalAccuracy, correctWords, correctPositions, totalWords, wordMatches) {
        if (totalWords === 0) return "No words to compare";

        const incorrectWords = wordMatches.filter(w => !w.isCorrect);
        const outOfPositionWords = wordMatches.filter(w => w.isCorrect && !w.isInPosition);

        let analysis = "";

        if (incorrectWords.length === 0 && outOfPositionWords.length === 0) {
            return `Perfect! All ${totalWords} words are pronunced correctly and in the right order! 🎉`;
        }

        if (incorrectWords.length === 0 && outOfPositionWords.length > 0) {
            const positionMsg = outOfPositionWords.length === 1
                ? `word is in the wrong place: '${outOfPositionWords[0].word}' should be at position ${outOfPositionWords[0].position + 1}`
                : `word is in the wrong place: ${outOfPositionWords.map(w => `'${w.word}'`).join(', ')}`;

            return `You pronunced every word correctly, but ${outOfPositionWords.length} ${positionMsg}. Focus on word order! 📝`;
        }

        if (incorrectWords.length === 1) {
            return `Almost perfect! Only one word to work on: '${incorrectWords[0].word}'`;
        }

        const problemWords = incorrectWords.slice(0, 3).map(w => `'${w.word}'`).join(", ");
        if (incorrectWords.length > 3) {
            return `You got ${correctWords} out of ${totalWords} words correct. ${correctPositions} of them were in the right place. Focus on: ${problemWords} and ${incorrectWords.length - 3} more`;
        }

        return `You got ${correctWords} out of ${totalWords} words correctly. ${correctPositions} of them were in the right place. Focus on: ${problemWords}`;
    }

    // Display transcription and accuracy results
    function displayResults(userSpeech, result) {
        const accuracy = result.accuracy;

        // Display user's speech
        userSpeech.textContent = userSpeech;

        // Update progress bar with animation
        accuracyProgress.style.transition = "width 0.5s ease";
        accuracyProgress.style.width = accuracy + "%";
        accuracyPercentage.textContent = accuracy + "%";

        // Update score and streak
        updateScoreAndStreak(accuracy);

        // Display feedback
        feedbackMessage.textContent = result.feedback;
        feedbackMessage.className = `feedback-message ${getFeedbackClass(accuracy)}`;

        // Display detailed analysis
        if (result.detailedAnalysis) {
            detailedAnalysis.textContent = result.detailedAnalysis;
            detailedAnalysis.style.display = "block";
        }

        // Display word breakdown if available
        if (result.wordMatches && result.wordMatches.length > 0) {
            displayWordBreakdown(result.wordMatches);
            wordBreakdown.style.display = "block";
        }

        // Show result section
        resultSection.style.display = "block";

        // Scroll to results smoothly
        resultSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    // Update displayWordBreakdown to show position information
    function displayWordBreakdown(wordMatches) {
        wordList.innerHTML = "";

        // Add header with position info
        const headerRow = document.createElement("div");
        headerRow.className = "word-breakdown-header";
        headerRow.innerHTML = `
        <span class="word-header">Expected words,</span>
        <span class="pos-header">Position,</span>
        <span class="status-header">Status:</span>
    `;
        wordList.appendChild(headerRow);

        wordMatches.forEach((match, index) => {
            const wordElement = document.createElement("div");
            let statusClass = "word-item";
            let statusIcon = "";
            let positionInfo = "";

            if (match.isCorrect) {
                if (match.isInPosition) {
                    statusClass += " correct-position";
                    statusIcon = "✓✓"; // Double check for correct position
                } else {
                    statusClass += " correct-wrong-position";
                    statusIcon = "✓✗"; // Check + X for wrong position
                    positionInfo = `<span class="position-info">(på plads ${match.actualPosition + 1})</span>`;
                }
            } else {
                statusClass += " incorrect";
                statusIcon = "✗";
            }

            wordElement.className = statusClass;
            wordElement.innerHTML = `
            <span class="word">${match.word}</span>
            <span class="position">${match.position + 1}</span>
            <span class="status">${statusIcon}</span>
            ${positionInfo}
            ${match.suggestedWord && !match.isCorrect ?
                `<span class="suggestion">→ ${match.suggestedWord}</span>` : ''}
        `;
            wordList.appendChild(wordElement);
        });
    }

    // Update score and streak based on accuracy
    function updateScoreAndStreak(accuracy) {
        if (accuracy >= 70) {
            totalScore += accuracy;
            currentStreak++;
        } else {
            currentStreak = 0;
        }

        scoreDisplay.textContent = Math.round(totalScore);
        streakDisplay.textContent = currentStreak;

        // Add streak animation if streak > 0
        if (currentStreak > 0) {
            streakDisplay.classList.add('streak-active');
        } else {
            streakDisplay.classList.remove('streak-active');
        }
    }

    // Get CSS class for feedback based on accuracy
    function getFeedbackClass(accuracy) {
        if (accuracy >= 70) return "success";
        if (accuracy >= 40) return "warning";
        return "error";
    }

    // Toggle hint display
    function toggleHint() {
        if (hintContent.style.display === "none") {
            hintContent.style.display = "block";
            showHintBtn.querySelector('.hint-text').textContent = "Hide Hint";
        } else {
            hintContent.style.display = "none";
            showHintBtn.querySelector('.hint-text').textContent = "Show Hint";
        }
    }

    // Shuffle cards
    function shuffleCards() {
        filteredFlashcards = [...filteredFlashcards].sort(() => Math.random() - 0.5);
        currentCardIndex = 0;
        updateCard();
    }

    // Show card information modal
    function showCardInfo() {
        const card = filteredFlashcards[currentCardIndex];
        if (!card) return;

        const modalContent = document.getElementById("modalContent");
        modalContent.innerHTML = `
            <p><strong>Prompt:</strong> ${card.prompt}</p>
            <p><strong>Expected:</strong> ${card.expectedText || card.prompt}</p>
            <p><strong>Hint:</strong> ${card.hint || "No hint"}</p>
            <p><strong>Example:</strong> ${card.example || "No example"}</p>
            <p><strong>Phonetic:</strong> ${card.phoneticHint || "Not available"}</p>
            <p><strong>Difficulty:</strong> ${card.difficulty || "Beginner"}</p>
            <p><strong>Category:</strong> ${card.category || "General"}</p>
        `;

        infoModal.style.display = "block";
    }

    // Show error message
    function showError(message) {
        resultSection.style.display = "block";
        userSpeech.textContent = "Error processing recording";
        feedbackMessage.textContent = `Error: ${message}`;
        feedbackMessage.className = "feedback-message error";
    }

    function setupVAD(stream) {
        try {
            console.log("🔧 Setting up audio detection...");

            // Get sensitivity setting from dropdown
            let threshold = 0.08; // default medium
            if (noiseSensitivity && noiseSensitivity.value) {
                threshold = parseFloat(noiseSensitivity.value);
            }

            console.log(`Using sensitivity threshold: ${threshold}`);

            // Create audio context for level detection
            const audioContext = new AudioContext();
            const source = audioContext.createMediaStreamSource(stream);

            // Create analyser node for volume detection
            const analyser = audioContext.createAnalyser();
            source.connect(analyser);
            analyser.fftSize = 256;
            const dataArray = new Uint8Array(analyser.frequencyBinCount);

            // Resume audio context (required for autoplay policies)
            audioContext.resume().then(() => {
                console.log("🎵 AudioContext resumed, state:", audioContext.state);
            }).catch(err => {
                console.warn("Could not resume AudioContext:", err);
            });

            let speechActive = false;
            let silenceTimer = null;
            let frameCount = 0;
            let speechStartTime = null;

            // Variables for dynamic noise adaptation
            let backgroundNoiseLevel = threshold;
            let noiseSamples = [];
            const NOISE_SAMPLE_SIZE = 50;
            let lastNoiseUpdate = Date.now();

            // Store for cleanup
            window.audioContext = audioContext;
            window.audioAnalyser = analyser;

            // Debounced status update function
            function updateStatusWithDebounce(newStatus, delay = 200) {
                // Clear any pending update
                if (statusUpdateTimeout) {
                    clearTimeout(statusUpdateTimeout);
                }

                // Update immediately if it's a critical status or different from current
                if (newStatus.includes("Recording") || newStatus.includes("Ready") || lastStatusText !== newStatus) {
                    statusDiv.textContent = newStatus;
                    lastStatusText = newStatus;
                }

                // Set a timeout to potentially revert or update later if needed
                statusUpdateTimeout = setTimeout(() => {
                    statusUpdateTimeout = null;
                }, delay);
            }

            function detectSpeech() {
                frameCount++;

                // Log every 500 frames to reduce spam
                if (frameCount % 500 === 0) {
                    console.log(`🔍 Detection running (frame ${frameCount}), isRecording: ${isRecording}, speechActive: ${speechActive}`);
                }

                if (!isRecording) {
                    return;
                }

                try {
                    analyser.getByteTimeDomainData(dataArray);

                    // Calculate volume level
                    let sumSquares = 0;
                    let maxSample = 0;
                    for (let i = 0; i < dataArray.length; i++) {
                        const v = (dataArray[i] - 128) / 128;
                        maxSample = Math.max(maxSample, Math.abs(v));
                        sumSquares += v * v;
                    }
                    const rms = Math.sqrt(sumSquares / dataArray.length);

                    // Get current threshold (could be updated dynamically)
                    let currentThreshold = threshold;
                    if (noiseSensitivity && noiseSensitivity.value) {
                        currentThreshold = parseFloat(noiseSensitivity.value);
                    }

                    // Update background noise level during silence (not speaking)
                    if (!speechActive && maxSample < currentThreshold) {
                        noiseSamples.push(maxSample);
                        if (noiseSamples.length > NOISE_SAMPLE_SIZE) {
                            noiseSamples.shift();
                            // Calculate running average of background noise
                            const avgNoise = noiseSamples.reduce((a, b) => a + b, 0) / noiseSamples.length;
                            // Set threshold slightly above average noise (dynamic adaptation)
                            backgroundNoiseLevel = Math.min(avgNoise * 1.5, currentThreshold);

                            // Update threshold periodically (every 2 seconds)
                            const now = Date.now();
                            if (now - lastNoiseUpdate > 2000) {
                                console.log(`🌊 Background noise: ${avgNoise.toFixed(4)}, Adaptive threshold: ${backgroundNoiseLevel.toFixed(4)}`);
                                lastNoiseUpdate = now;
                            }
                        }
                    }

                    // Determine effective threshold (adaptive or fixed)
                    const effectiveThreshold = (!speechActive && backgroundNoiseLevel > currentThreshold)
                        ? backgroundNoiseLevel
                        : currentThreshold;

                    // Log levels occasionally
                    if (frameCount % 500 === 0) {
                        console.log(`📊 Audio - Peak: ${maxSample.toFixed(4)}, RMS: ${rms.toFixed(4)}, Threshold: ${effectiveThreshold.toFixed(4)}, SpeechActive: ${speechActive}`);
                    }

                    // SPEECH DETECTION - START OR CONTINUE SPEECH
                    if ((maxSample > effectiveThreshold || rms > effectiveThreshold)) {
                        if (!speechActive) {
                            // New speech started
                            speechStartTime = Date.now();
                            console.log(`🎤 SPEECH STARTED! Peak: ${maxSample.toFixed(4)}, RMS: ${rms.toFixed(4)}, Threshold: ${effectiveThreshold.toFixed(4)}`);
                            speechActive = true;
                            speechDetected = true;

                            if (silenceTimer) {
                                clearTimeout(silenceTimer);
                                silenceTimer = null;
                            }

                            updateStatusWithDebounce("🔴 Speaking...", 100);
                        }
                        // If already speechActive, just continue - don't reset anything
                    }
                    // SILENCE DETECTION - END OF SPEECH
                    else if (speechActive && !silenceTimer) {
                        // Speech has ended - check if it was long enough to be considered real speech
                        const speechDuration = Date.now() - speechStartTime;
                        const MIN_SPEECH_DURATION = 150; // 150ms minimum speech (reduced from 300)

                        if (speechDuration >= MIN_SPEECH_DURATION) {
                            console.log(`🔇 Speech ended after ${speechDuration}ms, starting ${SILENCE_THRESHOLD_MS}ms timer`);
                            speechActive = false;
                            speechDetected = false;
                            silenceStart = Date.now();

                            silenceTimer = setTimeout(() => {
                                if (isRecording && !speechActive) {
                                    const silenceDuration = Date.now() - silenceStart;
                                    console.log(`⏹️ AUTO-STOPPING after ${silenceDuration}ms of silence`);
                                    stopRecording();
                                }
                                silenceTimer = null;
                            }, SILENCE_THRESHOLD_MS);

                            updateStatusWithDebounce(`⏸️ Silence detected, stopping in ${SILENCE_THRESHOLD_MS/1000}s...`, 100);
                        } else {
                            // Ignore very short sounds (like clicks or pops)
                            console.log(`Ignoring short sound of ${speechDuration}ms (below ${MIN_SPEECH_DURATION}ms threshold)`);
                            speechActive = false;
                            // Don't set silenceStart or start timer for these short sounds
                        }
                    }
                    // FALLBACK: Check if we should stop after prolonged silence
                    else if (!speechActive && silenceStart && !silenceTimer) {
                        const silenceDuration = Date.now() - silenceStart;
                        if (silenceDuration > SILENCE_THRESHOLD_MS && isRecording) {
                            console.log(`⏹️ AUTO-STOP (fallback) after ${silenceDuration}ms`);
                            stopRecording();
                        }
                    }

                    // Continue detection
                    requestAnimationFrame(detectSpeech);
                } catch (error) {
                    console.error("Error in speech detection:", error);
                    requestAnimationFrame(detectSpeech);
                }
            }

            // Start detection immediately
            console.log("🚀 Starting detection loop...");
            detectSpeech();

            console.log("✅ Audio level detection started successfully");
            return true;

        } catch (error) {
            console.error("❌ Error setting up audio detection:", error);
            return false;
        }
    }

    window.addEventListener("load", async () => {
        try {
            const permission = await navigator.permissions.query({ name: "microphone" });

            if (permission.state === "granted") {
                // Mikrofon er allerede tilladt → start optagelse med det samme
                toggleRecording();
            } else {
                // Mikrofon ikke tilladt endnu → brug alert for at få en user gesture
                alert("To make speech recognition work, the microphone has to be used. Press OK, thereafter allow microphone use");
                toggleRecording();
            }

        } catch (err) {
            // Hvis permissions API ikke er understøttet (fx i Safari)
            alert("To make speech recognition work, the microphone has to be used. Press OK, thereafter allow microphone use");
            toggleRecording();
        }
    });

    // Initialize on page load
    document.addEventListener("DOMContentLoaded", initialize);

</script>